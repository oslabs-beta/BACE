{
  "name": "Three-tools",
  "version": "0.4.1",
  "description": "Developer tools for 3D library three.js.",
  "manifest_version": 3,
  "devtools_page": "src/extension/devtools.html",
  "background": {
    "service_worker": "src/extension/background.js"
  },
  "icons": {
    "128": "assets/icon_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/extension/contentScript.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [{
    "resources": [
      "src/content/*.js",
      "src/content/injected-script.js"
    ],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"
  },
  "author": "Emily Bae, Katie Ahn, Alyssa Chew, & Karl Eden"
}